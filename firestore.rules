rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email == 'suvankarall2029@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function hasValidCompletedRegistration(data) {
      return !('registrationCompleted' in data) ||
             data.registrationCompleted == false ||
             (
               data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 50 &&
               data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 50 &&
               data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150 &&
               data.age is int && data.age >= 13 && data.age <= 120 &&
               data.purpose is string && data.purpose.size() >= 2 && data.purpose.size() <= 100 &&
               data.interests is list && data.interests.size() >= 1 && data.interests.size() <= 20 &&
               (data.email.size() >= 3 || ('phoneNumber' in data && data.phoneNumber is string && data.phoneNumber.size() >= 7))
             );
    }

    function isValidUserCore(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             !('password' in data) &&
             !('passwordHash' in data) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.email is string && data.email.size() <= 150 &&
             (!('status' in data) || data.status in ['ACTIVE', 'SUSPENDED']) &&
             (!('role' in data) || data.role in ['USER', 'ADMIN']) &&
             (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 10)) &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('age' in data) || data.age == null || (data.age is int && data.age >= 0 && data.age <= 120)) &&
             (!('interests' in data) || (data.interests is list && data.interests.size() <= 20 && (data.interests.size() == 0 || data.interests[0] is string)));
    }

    function isValidUserStrings(data) {
      return (!('publicUserId' in data) || data.publicUserId == null || (data.publicUserId is string && data.publicUserId.size() <= 40)) &&
             (!('firstName' in data) || data.firstName == null || (data.firstName is string && data.firstName.size() <= 50)) &&
             (!('middleName' in data) || data.middleName == null || (data.middleName is string && data.middleName.size() <= 50)) &&
             (!('lastName' in data) || data.lastName == null || (data.lastName is string && data.lastName.size() <= 50)) &&
             (!('fullName' in data) || data.fullName == null || (data.fullName is string && data.fullName.size() <= 150)) &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('countryCode' in data) || data.countryCode == null || (data.countryCode is string && data.countryCode.size() <= 10)) &&
             (!('dateOfBirth' in data) || data.dateOfBirth == null || (data.dateOfBirth is string && data.dateOfBirth.size() <= 20)) &&
             (!('ageGroup' in data) || data.ageGroup == null || (data.ageGroup is string && data.ageGroup.size() <= 20)) &&
             (!('purpose' in data) || data.purpose == null || (data.purpose is string && data.purpose.size() <= 100)) &&
             (!('otherPurpose' in data) || data.otherPurpose == null || (data.otherPurpose is string && data.otherPurpose.size() <= 200));
    }

    function isValidUserFlags(data) {
      return (!('emailVerified' in data) || data.emailVerified is bool) &&
             (!('phoneVerified' in data) || data.phoneVerified is bool) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('registrationCompleted' in data) || data.registrationCompleted is bool) &&
             (!('authProvider' in data) || data.authProvider in ['GOOGLE', 'PHONE', 'EMAIL']) &&
             (!('lastLoginAt' in data) || data.lastLoginAt == null || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidUser(data) {
      return isValidUserCore(data) &&
             isValidUserStrings(data) &&
             isValidUserFlags(data) &&
             hasValidCompletedRegistration(data);
    }

    function isValidEnrollment(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 100 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 200 &&
             (!('completedLessonIds' in data) || (data.completedLessonIds is list && data.completedLessonIds.size() <= 200)) &&
             (!('progressPercent' in data) || (data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100)) &&
             (!('lastLessonId' in data) || data.lastLessonId == null || (data.lastLessonId is string && data.lastLessonId.size() <= 100)) &&
             (!('lastAccessedAt' in data) || data.lastAccessedAt == null || (data.lastAccessedAt is timestamp && data.lastAccessedAt <= request.time)) &&
             (!('isPaid' in data) || data.isPaid is bool) &&
             (!('orderId' in data) || data.orderId == null || (data.orderId is string && data.orderId.size() <= 100));
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 100 &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['PENDING', 'SUCCESS', 'FAILED'] &&
             (!('courseTitle' in data) || (data.courseTitle is string && data.courseTitle.size() <= 200)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('paymentProvider' in data) || (data.paymentProvider is string && data.paymentProvider.size() <= 50)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('transactionId' in data) || data.transactionId == null || (data.transactionId is string && data.transactionId.size() <= 100)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.read is bool &&
             (!('titleBn' in data) || data.titleBn == null || (data.titleBn is string && data.titleBn.size() <= 200)) &&
             (!('messageBn' in data) || data.messageBn == null || (data.messageBn is string && data.messageBn.size() <= 600)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50));
    }

    function isValidSupportTicket(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 150 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['OPEN', 'RESOLVED'];
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.createdAt <= request.time &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'USER') &&
                       (!('status' in request.resource.data) || request.resource.data.status == 'ACTIVE') &&
                       isValidUser(request.resource.data);

      allow update: if isSignedIn() &&
                       isValidUser(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt && (
                         // Action 1: Owner updates own profile / completes registration / updates login timestamp (cannot modify role or status)
                         (
                           request.auth.uid == userId &&
                           resource.data.userId == request.auth.uid &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'displayName', 'photoUrl', 'language', 'publicUserId',
                             'firstName', 'middleName', 'lastName', 'fullName',
                             'email', 'phoneNumber', 'countryCode',
                             'age', 'dateOfBirth', 'ageGroup',
                             'purpose', 'otherPurpose', 'interests',
                             'emailVerified', 'phoneVerified', 'isVerified',
                             'registrationCompleted', 'authProvider',
                             'lastLoginAt', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Authorized Admin manages status, role, or verification status
                         (
                           isAdmin() &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'role', 'isVerified', 'emailVerified', 'phoneVerified', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- Admin Registry Collection ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() &&
                       isValidId(adminUid) &&
                       incoming().userId == adminUid &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'grantedBy', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Duplicate Contact Locks (No PII stored; hash only) ---
    match /contactLocks/{contactHash} {
      allow get: if isSignedIn() && isValidId(contactHash);
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(contactHash) &&
                       incoming().userId == request.auth.uid &&
                       incoming().contactType in ['EMAIL', 'PHONE'] &&
                       incoming().keys().hasAll(['userId', 'contactType', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'contactType', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if false;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if isSignedIn() && resource.data.published == true;
      allow write: if false;
    }

    // --- Lessons Collection ---
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Enrollments Collection ---
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidId(enrollmentId) &&
                       incoming().enrolledAt is timestamp &&
                       incoming().enrolledAt <= request.time &&
                       isValidEnrollment(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().courseId == existing().courseId &&
                       incoming().enrolledAt == existing().enrolledAt &&
                       isValidEnrollment(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['completedLessonIds', 'progressPercent', 'lastLessonId', 'lastAccessedAt']);
      allow delete: if false;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidId(orderId) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidOrder(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().courseId == existing().courseId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidOrder(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'transactionId', 'paymentMethod', 'updatedAt']);
      allow delete: if false;
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidId(notificationId) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidNotification(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidNotification(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Announcements Collection ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Support Tickets Collection ---
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidId(ticketId) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidSupportTicket(incoming());
      allow update, delete: if false;
    }
  }
}
